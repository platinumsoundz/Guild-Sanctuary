# Public browser configuration. These are not secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase credential. Required for in-app account deletion and
# media cleanup. Never prefix this with NEXT_PUBLIC_ or expose it to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical HTTPS origin used for deployment documentation and future absolute links.
APP_BASE_URL=

# Google AdSense web placements. IDs are public; configure them before building
# web deployments. Ads stay disabled until a valid publisher ID is set and the
# visitor grants consent. Update public/ads.txt if the publisher ID changes.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Token wallet checkout (staged). These values belong in Supabase Edge Function
# secrets, not the Next.js client bundle. Keep checkout disabled by default;
# only enable it for isolated Stripe-test staging after the migration, functions,
# Price IDs, webhook, and end-to-end checks are verified. Live sales also need
# refund/chargeback handling and a support policy.
TOKEN_CHECKOUT_ENABLED=false
STRIPE_TOKEN_MODE=test
STRIPE_SECRET_KEY=
STRIPE_TOKEN_WEBHOOK_SECRET=
STRIPE_TOKEN_PRICE_100_ID=
STRIPE_TOKEN_PRICE_600_ID=
STRIPE_TOKEN_PRICE_1200_ID=
NEXT_PUBLIC_ADSENSE_SLOT_FEED_INLINE=
NEXT_PUBLIC_ADSENSE_SLOT_FEED_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_SHORTS=

# Native AdMob settings for Android builds. Native placements are excluded from
# the web bundle and are imported only from src/modules/ads/native.ts.
ADMOB_ANDROID_APP_ID=
NEXT_PUBLIC_ADMOB_ANDROID_BANNER_ID=
NEXT_PUBLIC_ADMOB_ANDROID_INTERSTITIAL_ID=
NEXT_PUBLIC_ADMOB_TEST_MODE=false

# Public HTTPS URL used only for Capacitor release builds.
CAPACITOR_SERVER_URL=
CAPACITOR_RELEASE_BUILD=false
