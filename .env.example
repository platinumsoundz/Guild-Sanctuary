# Public browser configuration. These are not secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase credential. Required for in-app account deletion and
# media cleanup. Never prefix this with NEXT_PUBLIC_ or expose it to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Account deletion grace period. Deletion is scheduled for seven days and the
# profile is hidden immediately. A scheduler calls POST /api/account/purge with
# this secret as a Bearer token (minimum 32 characters) once the grace period
# ends. Never expose it to the client.
ACCOUNT_PURGE_SECRET=

# Terms acceptance stays off until the /terms, /privacy, and /guidelines pages
# are approved and no longer marked as drafts. The app can still record
# acceptance for future use when this is on; do not enable it before the text
# is final.
NEXT_PUBLIC_TERMS_REQUIRED=false

# Canonical HTTPS origin and Stripe community-contribution feature flags.
APP_BASE_URL=
COMMUNITY_TIPS_ENABLED=false
# Configure the donation URL and enable flag in Vercel Production only.
# The server returns this link only when VERCEL_ENV=production and the flag is true.
STRIPE_DONATION_LINK_ENABLED=false
STRIPE_DONATION_URL=

# Token wallet checkout (staged). These values belong in Supabase Edge Function
# secrets, not the Next.js client bundle. Keep checkout disabled by default;
# only enable it for isolated Stripe-test staging after the migration, functions,
# Price IDs, webhook, and end-to-end checks are verified. Live sales also need
# refund/chargeback handling and a support policy.
TOKEN_CHECKOUT_ENABLED=false
STRIPE_TOKEN_MODE=test
STRIPE_SECRET_KEY=
STRIPE_TOKEN_WEBHOOK_SECRET=
STRIPE_TOKEN_PRICE_100_ID=
STRIPE_TOKEN_PRICE_600_ID=
STRIPE_TOKEN_PRICE_1200_ID=

# AdSense requires both the explicit flag and an explicitly marked production
# deployment. Vercel supplies VERCEL_ENV=production; Cloudflare Workers and other
# hosts must set NEXT_PUBLIC_DEPLOYMENT_ENV=production in the production build.
# Keep this blank/false locally and in previews. The publisher ID is public, but
# configure it only after the domain is verified and consent is in place.
NEXT_PUBLIC_DEPLOYMENT_ENV=
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
# One responsive feed unit: right rail on desktop, bottom of feed on mobile.
NEXT_PUBLIC_ADSENSE_SLOT_FEED_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_SHORTS=

# Native AdMob settings for Android builds. Native placements are excluded from
# the web bundle and are imported only from src/modules/ads/native.ts.
ADMOB_ANDROID_APP_ID=
NEXT_PUBLIC_ADMOB_ANDROID_BANNER_ID=
NEXT_PUBLIC_ADMOB_ANDROID_INTERSTITIAL_ID=
NEXT_PUBLIC_ADMOB_TEST_MODE=false

# Public HTTPS URL used only for Capacitor release builds.
CAPACITOR_SERVER_URL=
CAPACITOR_RELEASE_BUILD=false
