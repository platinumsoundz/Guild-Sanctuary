# Public browser configuration. These are not secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase credential. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical HTTPS origin and Stripe community-contribution feature flag.
APP_BASE_URL=
COMMUNITY_TIPS_ENABLED=false

# Optional public hosted checkout/payment destinations. Leave blank until ready.
# Digital-goods entitlements are not yet fulfilled by Lemon Squeezy.
LEMON_SQUEEZY_CHECKOUT_URL=
MONZO_CONTRIBUTION_URL=

# Server-only Stripe credentials and fixed catalog Price IDs.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TIP_5_USD=
STRIPE_PRICE_TIP_10_USD=
STRIPE_PRICE_TIP_25_USD=

# Configure these only as Supabase Edge Function secrets, not in the client bundle.
# Keep false by default; only enable for isolated Stripe-test staging after setup. Live sales need refund/chargeback handling first.
TOKEN_CHECKOUT_ENABLED=false
STRIPE_TOKEN_MODE=test
STRIPE_TOKEN_WEBHOOK_SECRET=
STRIPE_TOKEN_PRICE_100_ID=
STRIPE_TOKEN_PRICE_600_ID=
STRIPE_TOKEN_PRICE_1200_ID=

# Google AdSense web placements. IDs are public; configure them before building web deployments.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-8267279636493149
NEXT_PUBLIC_ADSENSE_SLOT_FEED_INLINE=
NEXT_PUBLIC_ADSENSE_SLOT_FEED_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_SHORTS=

# Native AdMob settings for Android builds.
ADMOB_ANDROID_APP_ID=
NEXT_PUBLIC_ADMOB_ANDROID_BANNER_ID=
NEXT_PUBLIC_ADMOB_ANDROID_INTERSTITIAL_ID=
NEXT_PUBLIC_ADMOB_TEST_MODE=false

# Public HTTPS URL used only for Capacitor release builds.
CAPACITOR_SERVER_URL=
CAPACITOR_RELEASE_BUILD=false
